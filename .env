# Credentials & Endpoints
MAL_CLIENT_ID=your_actual_mal_client_id_here
API_BASE=https://myanimelist.net
ANIME_URL=https://myanimelist.net{}
CHARACTERS_URL=https://myanimelist.net{}/characters

# Scraper Settings
START_ID=1
MAX_ID_OVERRIDE=0
CONCURRENCY=5
REQUEST_DELAY=1.5
PAGE_TIMEOUT=60000

# Retry & Error Handling
PAGE_ERROR_MAX_RETRIES=5
API_MAX_RETRIES=5
MISSING_CONFIRM_LOADS=2

# Storage paths
MAIN_DB=anime.db
MISSING_DB=missing.db
DONE_FILE=done.jsonl
EXPORT_DIR=export
